---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, socials, posts: postsConfig, home } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-10 pb-8">
      {
        home.eyebrow && (
          <p class="text-muted-foreground font-mono text-sm">
            <span class="text-accent">{site.prompt}</span> {home.eyebrow}
          </p>
        )
      }

      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        {home.heading}
      </h1>

      {
        home.statusLine && (
          <p class="border-border/80 text-muted-foreground bg-surface mt-5 inline-flex items-center gap-2.5 border px-3 py-1.5 font-mono text-sm">
            <span
              class="bg-accent size-2 animate-pulse rounded-full"
              aria-hidden="true"
            />
            {home.statusLine}
          </p>
        )
      }

      {
        home.intro && (
          <p class="mt-5 max-w-2xl text-lg leading-relaxed">{home.intro}</p>
        )
      }

      {
        home.buttons.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center gap-3">
            {home.buttons.map(button => (
              <LinkButton
                href={button.href}
                target={button.target}
                class="border-border text-foreground hover:border-accent hover:text-accent hover:bg-accent/5 inline-flex items-center gap-2 border px-4 py-2 font-mono text-sm transition-colors"
              >
                {button.label}
              </LinkButton>
            ))}
            <a
              target="_blank"
              href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
              class="border-border text-foreground hover:border-accent hover:text-accent border p-2 transition-colors"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss class="size-5" />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
        )
      }

      {
        socials.length > 0 && (
          <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="text-muted-foreground font-mono text-sm">
              {t.home.socialLinks}
            </span>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-10 pb-4",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-muted-foreground font-mono text-sm font-medium tracking-widest uppercase">
            <span class="text-accent">{site.prompt}</span> {t.home.featured}
          </h2>
          <ul class="mt-2">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-4">
          <h2 class="text-muted-foreground font-mono text-sm font-medium tracking-widest uppercase">
            <span class="text-accent">{site.prompt}</span> {t.home.recentPosts}
          </h2>
          <ul class="mt-2">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      (featuredPosts.length > 0 || recentPosts.length > 0) && (
        <div class="my-8 text-center">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="text-accent hover:text-foreground inline-flex items-center gap-1 border-b pb-0.5 font-mono text-sm"
          >
            {t.home.allPosts}
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
