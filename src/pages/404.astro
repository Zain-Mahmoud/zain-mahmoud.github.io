---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.notFound.title} | ${config.site.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout my-1 flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-accent text-8xl font-bold tracking-tight">404</h1>
      <p class="text-muted-foreground mt-2 font-mono text-sm">
        <span class="text-accent">{config.site.prompt}</span> exit: page not found
      </p>
      <p class="mt-4 text-xl sm:text-xl">{t.notFound.message}</p>
      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="border-border text-foreground hover:border-accent hover:text-accent mt-6 border px-4 py-2 font-mono text-sm transition-colors"
      >
        {t.notFound.goHome}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
