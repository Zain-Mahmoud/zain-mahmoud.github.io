---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const { site, footer } = config;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col gap-5 border-t py-6 sm:flex-row sm:items-center sm:justify-between sm:py-5"
  >
    <Socials />
    <div class="flex flex-col items-start gap-0.5 text-sm">
      <div class="text-muted-foreground font-mono whitespace-nowrap">
        <span class="text-accent">{site.prompt}</span> &#169; {
          currentYear
        }&nbsp;
        {site.title}
      </div>
      {footer.note && <p class="text-muted-foreground/80">{footer.note}</p>}
    </div>
  </div>
</footer>
